# ── FLUXMEDIA environment ─────────────────────────────────────────────
# Copy to .env.local and fill in for production. The site runs without
# any of these (built-in local CMS adapter), but production should use
# Supabase + real secrets. NEVER commit .env / .env.local.

# Supabase (optional at runtime — see supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access
ADMIN_PASSWORD=change-me-admin-password

# Cookie signing secret
SESSION_SECRET=generate-a-long-random-string

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
